<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Admin.Api</RootNamespace>
    <AssemblyName>Admin.Api</AssemblyName>
    <!-- The same reason the analytics API keeps it: a named time zone needs ICU. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- This tool is never published anywhere. It runs on one machine, from the repository. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\analytics\Analytics.Domain\Analytics.Domain.csproj" />
    <ProjectReference Include="..\..\analytics\Analytics.Infrastructure\Analytics.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FastEndpoints" Version="8.3.0" />
  </ItemGroup>

</Project>
