@echo off
rem Copy this to admin-live.env.cmd, which git ignores, and put the real
rem connection string in it. start-admin-prod.cmd calls it when the variable is
rem not already set in the environment.
rem
rem This is a secret: it is the whole way into the storage account that holds
rem everything the site has collected. It belongs here or in your own
rem environment, and nowhere that is committed.

set "Admin__AzureWebJobsStorage=DefaultEndpointsProtocol=https;AccountName=REPLACE;AccountKey=REPLACE;EndpointSuffix=core.windows.net"

rem Where the deployed API answers, for the health panel. Not a secret, and not
rem required: without it the panel says it has nothing to ask, and every other
rem figure on the page still comes off this machine.
set "Admin__AnalyticsApiUrl=https://api.christianszasz.dev"
