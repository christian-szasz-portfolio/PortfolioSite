{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "schematicCollections": [
      "angular-eslint"
    ]
  },
  "newProjectRoot": "projects",
  "projects": {
    "landing-ng": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "changeDetection": "OnPush"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "src/material-theme.scss",
              "src/styles.scss"
            ],
            "server": "src/main.server.ts",
            "outputMode": "static",
            "security": {
              "allowedHosts": []
            },
            "allowedCommonJsDependencies": [
              "jspdf",
              "canvg",
              "dompurify",
              "html2canvas",
              "core-js",
              "raf",
              "rgbcolor",
              "fflate"
            ],
            "localize": true,
            "polyfills": [
              "@angular/localize/init"
            ],
            "i18nMissingTranslation": "error"
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "480kB",
                  "maximumError": "600kB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kB",
                  "maximumError": "10kB"
                },
                {
                  "type": "bundle",
                  "name": "main",
                  "maximumWarning": "420kB",
                  "maximumError": "560kB"
                }
              ],
              "outputHashing": "all",
              "optimization": {
                "scripts": true,
                "fonts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                }
              }
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "en-GB": {
              "localize": [
                "en-GB"
              ]
            },
            "de": {
              "localize": [
                "de"
              ]
            },
            "ro": {
              "localize": [
                "ro"
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "proxyConfig": "proxy.conf.json"
          },
          "configurations": {
            "production": {
              "buildTarget": "landing-ng:build:production"
            },
            "development": {
              "buildTarget": "landing-ng:build:development"
            },
            "en-GB": {
              "buildTarget": "landing-ng:build:development,en-GB"
            },
            "de": {
              "buildTarget": "landing-ng:build:development,de"
            },
            "ro": {
              "buildTarget": "landing-ng:build:development,ro"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "setupFiles": [
              "src/test-setup.ts"
            ],
            "buildTarget": "landing-ng:build"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "src/**/*.ts",
              "src/**/*.html",
              "e2e/**/*.ts",
              "playwright.config.ts"
            ]
          }
        }
      },
      "i18n": {
        "sourceLocale": {
          "code": "en-GB",
          "subPath": ""
        },
        "locales": {
          "de": {
            "translation": "src/locale/messages.de-DE.json",
            "subPath": "de-DE"
          },
          "ro": {
            "translation": "src/locale/messages.ro-RO.json",
            "subPath": "ro-RO"
          }
        }
      }
    }
  }
}
