{
  "name": "landing-ng",
  "version": "1.0.0",
  "scripts": {
    "start": "ng serve",
    "start:de": "ng serve --configuration de",
    "start:ro": "ng serve --configuration ro",
    "build": "ng build",
    "test": "ng test",
    "e2e": "playwright test",
    "e2e:report": "playwright show-report e2e-results/report",
    "serve": "site-tools serve --site portfolio",
    "serve:rewrites": "site-tools serve-rewrites --site portfolio",
    "lint": "ng lint",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\" \"e2e/**/*.ts\" playwright.config.ts",
    "postbuild": "site-tools sitemap --site portfolio && site-tools style-hashes --site portfolio && site-tools headers --site portfolio",
    "diagrams": "site-tools diagrams --site portfolio"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/cdk": "^22.1.2",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/localize": "^22.1.2",
    "@angular/material": "^22.1.2",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-server": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/ssr": "^22.1.4",
    "@christian-szasz-portfolio/common-web": "^0.17.7",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@lucide/icons": "^1.33.0",
    "fflate": "^0.8.3",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.4",
    "@angular/cli": "^22.1.4",
    "@angular/compiler-cli": "^22.1.0",
    "@eslint/js": "^10.0.1",
    "@iconify-json/simple-icons": "^1.2.93",
    "@playwright/test": "^1.62.1",
    "@types/node": "^20.19.43",
    "angular-eslint": "22.1.0",
    "eslint": "^10.6.0",
    "eslint-import-resolver-node": "^0.4.0",
    "eslint-plugin-import-x": "^4.17.1",
    "jsdom": "^28.0.0",
    "playwright": "^1.62.1",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.62.1",
    "vitest": "^4.0.8"
  }
}
